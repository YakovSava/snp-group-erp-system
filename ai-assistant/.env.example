POSTGRES_DB=ai_assistant
POSTGRES_USER=ai_assistant
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Shared secret auto-smm must send as the X-Service-Token header.
SERVICE_TOKEN=change-me-shared-secret

# OpenAI-compatible gateway
AI_BASE_URL=https://ai.tanakatatsuki.dev/v1
AI_API_KEY=sk-...
DEFAULT_CHAT_MODEL=gemini-3.8-flash-low
DEFAULT_IMAGE_MODEL=gemini-3.1-flash-image
HIGH_QUALITY_IMAGE_MODEL=gemini-3-pro-image

CHROMA_PATH=/app/chroma_data
MEDIA_ROOT=/app/media
EMBEDDING_MODEL=intfloat/multilingual-e5-small
