# Must match SOCIAL_PUBLISHER_SERVICE_TOKEN in the root .env.
SERVICE_TOKEN=change-me-shared-secret

# Every block below is optional. Leave a platform's vars blank (or delete
# them) to have it reported as "skipped_unconfigured" on every send instead
# of being called — the other configured platforms still go out normally.

# Facebook — a Page id + a Page access token with pages_manage_posts.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram — the IG Business Account id linked to the Facebook Page, and
# an access token (often the same token as Facebook's Page token above).
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Threads — its own user id + access token (separate API from FB/IG).
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Telegram — a bot token from @BotFather and the target chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MAX messenger — a bot token (dev.max.ru) and the target chat id.
MAX_BOT_TOKEN=
MAX_CHAT_ID=

# X (Twitter) — a full OAuth1 user-context credential set; posting needs
# all four, an app-only bearer token is not enough.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# VK — a community (group) access token with wall permission, and the
# numeric group id (without the minus sign).
VK_ACCESS_TOKEN=
VK_GROUP_ID=
