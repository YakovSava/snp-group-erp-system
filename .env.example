DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=snp_esb
POSTGRES_USER=snp_esb
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SNP ESB
WEBAUTHN_ORIGIN=http://localhost:8000

# Must match SERVICE_TOKEN in ai-assistant/.env.
# http://api:8000 works when started together via the root docker-compose.yml
# (which includes ai-assistant/docker-compose.yml onto the same network). If
# you instead run ai-assistant standalone (cd ai-assistant && docker compose
# up) alongside a separately-started auto-smm, switch this to
# http://host.docker.internal:8001 instead.
AI_ASSISTANT_BASE_URL=http://api:8000
AI_ASSISTANT_SERVICE_TOKEN=change-me-shared-secret

# Must match SERVICE_TOKEN in social-publisher/.env. Same http://publisher:8000
# vs host.docker.internal caveat as AI_ASSISTANT_BASE_URL above if run apart.
SOCIAL_PUBLISHER_BASE_URL=http://publisher:8000
SOCIAL_PUBLISHER_SERVICE_TOKEN=change-me-shared-secret

# Where other services (social-publisher) fetch this site's /media/ files
# from. Must be a real public domain in production — Facebook/Instagram/
# Threads fetch post images from their own servers, not over this Docker
# network.
SITE_BASE_URL=http://web:8000
