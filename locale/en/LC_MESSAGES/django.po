msgstr "Excel file (.xlsx)"

#, python-format
msgid "Файл слишком большой (максимум %(limit)s МБ)."
msgstr "File is too large (maximum %(limit)s MB)."

msgid "Наценка для RUB, % (если в файле нет столбца с ценой в рублях)"
msgstr "Markup for RUB, % (if the file has no column with the price in rubles)"

msgid "Наценка для USD, % (если в файле нет столбца с ценой в долларах)"
msgstr "Markup for USD, % (if the file has no column with the price in dollars)"

#, python-format
msgid "Столбец %(index)s"
msgstr "Column %(index)s"

#, python-format
msgid "Это поле уже назначено столбцу %(index)s — выберите другое значение."
msgstr "This field is already assigned to column %(index)s — choose a different value."

msgid "Поиск"
msgstr "Search"

msgid "По полю"
msgstr "By field"

msgid "Добавил"
msgstr "Added by"

msgid "Создан"
msgstr "Created"

msgid "Обновлён"
msgstr "Updated"

msgid "Позиция каталога"
msgstr "Catalog item"

msgid "Каталог"
msgstr "Catalog"

msgid "Проверка сопоставления столбцов"
msgstr "Review column mapping"

msgid "Строк с данными в файле:"
msgstr "Data rows in file:"

msgid "Столбец в файле"
msgstr "Column in file"

msgid "Что это"
msgstr "What it is"

msgid ""
"Наценки используются только для позиций, у которых не назначен отдельный "
"столбец с ценой в этой валюте."
msgstr ""

msgid "Предпросмотр (первые 10 строк)"
msgstr "Preview (first 10 rows)"

msgid ""
"Нет строк для предпросмотра — проверьте сопоставление столбцов (должен быть "
"назначен хотя бы Заголовок или Артикул)."
msgstr ""

msgid "Обновить предпросмотр"
msgstr "Refresh preview"

msgid "Импортировать всё"
msgstr "Import all"

msgid "Отменить импорт"
msgstr "Cancel import"

msgid "Импорт каталога"
msgstr "Catalog import"

msgid ""
"Загрузите прайс-лист поставщика (.xlsx) — AI предложит, какой столбец что "
"означает, вы сможете проверить и поправить это перед импортом."
msgstr ""

msgid "Загрузить и определить столбцы"
msgstr "Upload and detect columns"

msgid "Экспортировать"
msgstr "Export"

msgid "Импортировать"
msgstr "Import"

msgid "Найти"
msgstr "Search"

